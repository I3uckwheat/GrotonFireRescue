doctype html
html
  head
    title #{title || 'Groton Fire & Rescue'}
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="icon" href="/favicon.ico")
    link(rel="stylesheet" href="/stylesheets/reset.css")
    link(rel="stylesheet" href="/stylesheets/style.css")
    link(href="https://fonts.googleapis.com/css?family=Alfa+Slab+One" rel="stylesheet")
    block stylesheets

  body

    header
      a(href="/") #[img#cross(src="/images/cross.png" alt="Groton Fire & Rescue")]
      nav.primary-nav
        a(href="/") Home
        a(href="https://www.facebook.com/GrotonFireAndRescue/photos" target="_blank" rel="noopener") Photo Gallery
        a(href="https://www.facebook.com/GrotonFireAndRescue" target="_blank" rel="noopener") Gun Drawing
        a(href="/training") Training & Meetings

      img#hamburgerMenu.collapsed.hidden(src='/images/hamburgerMenuWhite.png')

    .content
      .titleContainer
        h1#pageTitle #{title}
        block userButton
      block content

  block scripts
  script(src="/javascript/layout.js")
