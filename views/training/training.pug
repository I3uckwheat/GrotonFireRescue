extends ../layout

block stylesheets
  link(rel="stylesheet" href="/stylesheets/training.css")

block content

  - const anyRepeats = trainingDays.some((day) => day.type === 'repeat')
  - const anySpecial = trainingDays.some((day) => day.type === 'special')

  .inner
    if(anyRepeats)
      .repeatTraining.training
        h4 Repeat Trainings/Meetings
        for day in trainingDays
          if (day.type === 'repeat')
            .card
              .cardInfo
                .cardTitle
                  h3.title= day.title
                  p.location= day.location
                  p.date= day.when
                  .arrowButton
                    .arrow.arrowDown
                  .accentLine
                .dropDown
                  pre.info= day.info

    if(anySpecial)
      .training
        h4 Special Trainings/Meetings
        for day in trainingDays
          if (day.type === 'special')
            .card
              .cardInfo
                .cardTitle
                  h3.title= day.title
                  p.location= day.location
                  p.date= day.when
                  .arrowButton
                    .arrow.arrowDown
                  .accentLine
                .dropDown
                  pre.info= day.info


block scripts
  script(src="/javascript/training.js")
